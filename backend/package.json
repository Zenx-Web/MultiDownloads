{
  "name": "media-fetch-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Controlled, queue-based media fetch backend (API + worker).",
  "type": "commonjs",
  "main": "dist/api.js",
  "scripts": {
    "dev:api": "ts-node src/api.ts",
    "dev:worker": "ts-node src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/integration-test.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
