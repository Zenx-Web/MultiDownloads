# Server
PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# Signing secret for download tokens (change in production)
DOWNLOAD_SIGNING_SECRET=change-me

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage
FILE_TTL_SECONDS=600

# Queue behavior
WORKER_POLL_INTERVAL_MS=1500
FREE_QUEUE_DELAY_SECONDS=30

# Limits
FREE_MAX_REQUESTS_PER_HOUR=2
PREMIUM_MAX_REQUESTS_PER_HOUR=10
FREE_MAX_DURATION_SECONDS=900
PREMIUM_MAX_DURATION_SECONDS=3600

# Per-user active job caps (queued + processing)
FREE_MAX_ACTIVE_JOBS=1
PREMIUM_MAX_ACTIVE_JOBS=2

# Premium gating (optional)
# If set, clients must provide X-Premium-Token matching this value to request premium plan.
PREMIUM_TOKEN=

# Metadata probing
# If ffprobe is available in PATH, we will use it to read duration.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_MS=8000
